# Environment (development/staging/production)
APP_ENV=development
PORT=8080

# Database
DATABASE_URL=postgres://doexam:secret@localhost:5433/doexam?sslmode=disable

# Auth: masa berlaku sesi login (durasi Go: 12h, 90m)
AUTH_SESSION_TTL=12h

# Penyimpanan file upload (impor, logo, media soal)
STORAGE_DIR=./data/storage

# Kunci tanda tangan link media soal (hex/base64, min. 16 byte). Kosong = dibuat sekali
# dan disimpan di STORAGE_DIR/system/media-signing.key. Isi bila beberapa server berbagi storage berbeda.
MEDIA_SIGNING_KEY=

# Cache konten soal. Kosong = in-memory (CONTENT_CACHE_MB). Isi untuk memakai Redis,
# mis. redis://localhost:6379/0 (layanan redis di docker-compose). Redis tidak wajib.
REDIS_URL=
CONTENT_CACHE_MB=64

# OpenTelemetry (kosongkan endpoint untuk mematikan tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=doexam-api
